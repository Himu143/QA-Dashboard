{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "Software project container for QA activities",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "key": { "type": "string" },
        "description": { "type": "string" },
        "color": { "type": "string" },
        "lead": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "key"]
    },
    "Bug": {
      "title": "Bug",
      "description": "Reported issue or defect",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "bugNumber": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "stepsToReproduce": { "type": "string" },
        "expectedResult": { "type": "string" },
        "actualResult": { "type": "string" },
        "severity": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "environment": { "type": "string" },
        "assignedTo": { "type": "string" },
        "reportedBy": { "type": "string" },
        "testCaseId": { "type": "string" },
        "testPlanId": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "resolutionNotes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "projectId", "title", "severity", "status"]
    },
    "TestPlan": {
      "title": "TestPlan",
      "description": "Test plan for scoping and organizing testing rounds",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "planNumber": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "version": { "type": "string" },
        "status": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "projectId", "title", "status"]
    },
    "TestCase": {
      "title": "TestCase",
      "description": "Structured test scenario with repeatable verification steps",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "testPlanId": { "type": "string" },
        "caseNumber": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "preconditions": { "type": "string" },
        "steps": { "type": "array" },
        "priority": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "projectId", "title", "status"]
    },
    "TestRun": {
      "title": "TestRun",
      "description": "Execution cycle of test cases generating test reports",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "testPlanId": { "type": "string" },
        "runNumber": { "type": "string" },
        "title": { "type": "string" },
        "environment": { "type": "string" },
        "executedBy": { "type": "string" },
        "status": { "type": "string" },
        "totalCases": { "type": "number" },
        "passedCases": { "type": "number" },
        "failedCases": { "type": "number" },
        "blockedCases": { "type": "number" },
        "skippedCases": { "type": "number" },
        "caseResults": { "type": "array" },
        "createdAt": { "type": "string" },
        "completedAt": { "type": "string" }
      },
      "required": ["id", "projectId", "title", "status"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Collaboration discussion on bugs and test entities",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorRole": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "entityType", "entityId", "content", "authorName"]
    },
    "Activity": {
      "title": "Activity",
      "description": "Audit log and team update feed",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" },
        "entityTitle": { "type": "string" },
        "actionType": { "type": "string" },
        "actorName": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "actionType", "actorName", "timestamp"]
    }
  }
}
